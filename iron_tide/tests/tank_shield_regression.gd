extends "res://tests/tank_hero_regression.gd"
const Shield=preload("res://scripts/units/tank_hero_shield.gd")

func _ready() -> void:
	output_dir=OS.get_environment("IRON_TIDE_REPORT_DIR")
	if output_dir.is_empty() or not OS.get_user_data_dir().contains("CodexIronTideValidation"):
		get_tree().quit(2);return
	MetaProgress.reset_save();start(MatchRules.EXTENDED)
	GM.god_mode=false;GM.one_shot_kill=false
	for id in Hero.IDS:
		var u=hero(id,0,0,Vector2(1300,1300))
		var maximum:float=u.max_hp
		Hero.tick(u,2.9)
		check(Shield.amount(u)==0,id+" no shield before three stationary seconds")
		u.velocity=Vector2(20,0);Hero.tick(u,0.1);u.velocity=Vector2.ZERO
		Hero.tick(u,2.9)
		check(Shield.amount(u)==0,id+" moving resets initial wait")
		Hero.tick(u,0.1)
		check(is_equal_approx(Shield.amount(u),maximum*0.15),id+" rank zero grants fifteen percent shield")
		Hero.tick(u,0.5)
		check(is_equal_approx(Shield.amount(u),maximum*0.15) and is_equal_approx(u.special[Shield.KEY].left,119.5),id+" addition waits full one second")
		Hero.tick(u,0.5)
		check(is_equal_approx(Shield.amount(u),maximum*0.2) and is_equal_approx(u.special[Shield.KEY].left,120),id+" five percent addition refreshes expiry")
		Hero.tick(u,6)
		check(is_equal_approx(Shield.amount(u),maximum*0.5),id+" ten total stationary seconds reaches fifty percent cap")
		Hero.tick(u,2)
		check(is_equal_approx(u.special[Shield.KEY].left,118),id+" full shield does not refresh without actual gain")
		var hp:float=u.hp
		var absorbed:=Ra2Damage.quantize(CombatMath.with_defense(12,u.bonuses))
		u.receive_hit(12,"bullet")
		check(u.hp==hp and is_equal_approx(Shield.amount(u),maximum*0.5-absorbed),id+" actual damage consumes shield before health")
		u.velocity=Vector2.RIGHT*20;Hero.tick(u,1)
		check(is_equal_approx(Shield.amount(u),maximum*0.5-absorbed),id+" movement retains shield but prevents recovery")
		u.velocity=Vector2.ZERO
		Hero.tick(u,1)
		check(is_equal_approx(Shield.amount(u),maximum*0.5-absorbed) and is_equal_approx(u.special[Shield.KEY].left,116),id+" residual shield stays reduced during initial recovery delay")
		check(not u.special[Shield.KEY].growing and u.special[Shield.KEY].damaged and u.special[Shield.KEY].charge==0,id+" movement cannot restart damaged shield growth")
		var damaged_codec=BattleSaves.Snapshot.new()
		damaged_codec.restore(battle,damaged_codec.capture(battle))
		u=battle.units.filter(func(n):return n.special.get("academy_hero")==id)[0]
		Hero.tick(u,1.9)
		check(is_equal_approx(Shield.amount(u),maximum*0.5-absorbed),id+" snapshot preserves interrupted recovery wait")
		Hero.tick(u,0.1)
		check(is_equal_approx(Shield.amount(u),maximum*0.5-absorbed) and is_equal_approx(u.special[Shield.KEY].left,114),id+" residual shield neither refills nor refreshes after three seconds")
		Hero.tick(u,30)
		check(is_equal_approx(Shield.amount(u),maximum*0.5-absorbed) and is_equal_approx(u.special[Shield.KEY].left,84),id+" long stationary wait cannot heal residual shield")
		check(Shield.describe(u).contains("残盾不能恢复"),id+" live tooltip explains shield lock")
		u.special[Shield.KEY].hp=maximum*0.1
		u.special[Shield.KEY].erase("rules");u.special[Shield.KEY].damaged=true
		Hero.tick(u,2.9)
		check(is_equal_approx(Shield.amount(u),maximum*0.1) and u.special[Shield.KEY].damaged,id+" old shield preserves amount and remains locked")
		Hero.tick(u,0.1)
		check(is_equal_approx(Shield.amount(u),maximum*0.1),id+" migrated residual shield cannot resume recovery")
		u.special[Shield.KEY].rules=2;u.special[Shield.KEY].erase("damaged")
		var old_left:float=u.special[Shield.KEY].left
		Hero.tick(u,10)
		check(u.special[Shield.KEY].rules==3 and u.special[Shield.KEY].damaged and is_equal_approx(Shield.amount(u),maximum*0.1) and is_equal_approx(u.special[Shield.KEY].left,old_left-10),id+" version two save without hit history keeps residual shield locked and lifetime intact")
		var near=battle.spawn_unit("MTNK","enemy",u.position+Vector2(80,0))
		var far=battle.spawn_unit("MTNK","enemy",u.position+Vector2(111,0))
		var friend=battle.spawn_unit("MTNK","ally",u.position+Vector2(30,0))
		var weapon:Dictionary=u._active_weapon().duplicate(true)
		weapon.damage=float(weapon.damage)*1.1
		var expected:=Ra2Damage.quantize(CombatMath.with_defense(CombatMath.full_damage(weapon,near.armor,u.bonuses,null,near.ra2_armor,0,near),near.bonuses))
		var near_hp:float=near.hp
		var far_hp:float=far.hp
		var friend_hp:float=friend.hp
		# Exactly exhaust shield through the real defense-adjusted receive_hit path.
		var defense:=CombatMath.with_defense(1,u.bonuses)
		var wave_count:=get_tree().get_nodes_in_group("shield_break_wave").size()
		u.receive_hit((Shield.amount(u)+10)/defense,"bullet")
		await get_tree().process_frame
		# process_frame can resume before the deferred damage burst is flushed.
		await get_tree().process_frame
		var waves:=get_tree().get_nodes_in_group("shield_break_wave")
		check(waves.size()==wave_count+1,id+" shield break creates one cosmetic shockwave")
		var wave=waves.back()
		check(wave.position==u.position and wave.radius==Shield.RADIUS,id+" shockwave center and boundary match actual damage")
		wave._process(Shield.Wave.LIFE)
		check(wave.is_queued_for_deletion(),id+" shockwave cleans itself up after its lifetime")
		check(Shield.amount(u)==0 and is_equal_approx(u.hp,hp-10),id+" shield break passes only excess damage to health")
		check(is_equal_approx(near_hp-near.hp,expected),id+" break deals one 110 percent main-gun attack with armor applied once")
		check(far.hp==far_hp and friend.hp==friend_hp,id+" break excludes beyond two cells and allies")
		Hero.tick(u,2.9)
		check(Shield.amount(u)==0,id+" break restarts full initial delay")
		Hero.tick(u,0.1)
		check(is_equal_approx(Shield.amount(u),maximum*0.15),id+" shield can rebuild after breaking")
		var codec=BattleSaves.Snapshot.new()
		Hero.tick(u,0.4)
		var snapshot:Dictionary=codec.capture(battle)
		codec.restore(battle,snapshot)
		u=battle.units.filter(func(n):return n.special.get("academy_hero")==id)[0]
		check(is_equal_approx(Shield.amount(u),maximum*0.15) and is_equal_approx(u.special[Shield.KEY].left,119.6),id+" save preserves shield amount and lifetime")
		Hero.tick(u,0.6)
		check(is_equal_approx(Shield.amount(u),maximum*0.2),id+" save preserves partial growth interval")
		var enemy=battle.units.filter(func(n):return n.side=="enemy" and not n._dead)[0]
		var enemy_hp:float=enemy.hp
		var expiry_waves:=get_tree().get_nodes_in_group("shield_break_wave").size()
		u.velocity=Vector2(20,0);Hero.tick(u,120)
		await get_tree().process_frame
		check(Shield.amount(u)==0 and enemy.hp==enemy_hp,id+" natural expiration while moving does not burst")
		check(get_tree().get_nodes_in_group("shield_break_wave").size()<=expiry_waves,id+" natural expiration does not create shockwave")
		u.velocity=Vector2.ZERO;Hero.tick(u,2.9)
		check(Shield.amount(u)==0,id+" expiration requires new initial delay")
		u.special.hero_command_rank=1
		Hero.tick(u,0.1)
		u.hp=0;u._die();Hero.tick(u,3)
		check(u.special.has("hero_wreck") and Shield.amount(u)==0,id+" wreck cannot retain or generate shield")
		Hero.tick(u,12);Hero.tick(u,3)
		check(is_equal_approx(Shield.amount(u),u.max_hp*0.15) and is_equal_approx(u.max_hp,maximum*0.5),id+" reborn shield uses reduced maximum health")
		Shield.clear(u)
	var normal=battle.spawn_unit("MTNK","ally",Vector2(500,500))
	Hero.tick(normal,20)
	check(not normal.special.has(Shield.KEY),"ordinary tank never receives hero shield")
	check(not Hero.COMMAND[0].contains("护盾") and Hero.DEFENSE[0]==Shield.DESCRIPTION,"shield belongs only to heavy survival rank zero")
	check(Shield.preview(3).fraction==0.15 and Shield.preview(10).fraction==0.5,"preview retains actual shield growth thresholds")
	check(Shield.preview(11).fraction==0.3 and Shield.preview(13.9).fraction==0.3,"preview holds residual shield during three second wait")
	check(Shield.preview(14).fraction==0.3 and Shield.preview(17.9).fraction==0.3 and Shield.preview(15).label.contains("不能恢复"),"preview never restores residual shield before break")
	check(Shield.preview(18).fraction==0 and Shield.preview(20.9).fraction==0 and Shield.preview(21).fraction==0.15,"preview waits three seconds after break before growing again")
	for id in Hero.IDS:
		BattleRequest.combat_context.get_or_add("loadouts",{})[id]={"active":["ap_smoke"],"passive":""}
		BattleRequest.combat_context.get_or_add("hero_loadouts",{})[id]={"active":["ap_smoke"],"passive":""}
		var initial=hero(id,0,0,Vector2(800,800))
		Hero.tick(initial,3.5)
		var before:float=Shield.amount(initial)
		Shield.absorb(initial,5)
		Hero.tick(initial,2.9)
		check(is_equal_approx(Shield.amount(initial),before-5),id+" hit during initial growth restarts full delay")
		Hero.tick(initial,0.1)
		check(is_equal_approx(Shield.amount(initial),before-5),id+" hit during initial growth locks the unfinished shield")
		Hero.tick(initial,10)
		check(is_equal_approx(Shield.amount(initial),before-5),id+" unfinished damaged shield cannot grow to cap")
		Shield.clear(initial);Hero.tick(initial,2.9)
		initial.receive_hit(1,"bullet")
		Hero.tick(initial,2.9)
		check(Shield.amount(initial)==0,id+" health hit with no shield also resets recovery")
		initial.receive_hit(1,"bullet");Hero.tick(initial,2.9)
		check(Shield.amount(initial)==0,id+" repeated hits keep interrupting initial wait")
		Hero.tick(initial,0.1)
		check(is_equal_approx(Shield.amount(initial),initial.max_hp*0.15),id+" recovery resumes three seconds after last health hit")
		var shot_target=battle.spawn_unit("HTNK","enemy",initial.position+Vector2(80,0))
		initial._fire_shot(shot_target)
		before=Shield.amount(initial)
		Hero.tick(initial,2.9)
		check(is_equal_approx(Shield.amount(initial),before),id+" actual normal shot interrupts residual shield regeneration")
		initial._fire_shot(shot_target);Hero.tick(initial,2.9)
		check(is_equal_approx(Shield.amount(initial),before),id+" repeated normal fire restarts delay")
		Hero.tick(initial,0.1)
		check(is_equal_approx(Shield.amount(initial),before+initial.max_hp*0.15),id+" stopping normal fire permits shield gain after three seconds")
		Shield.clear(initial);Hero.tick(initial,2.9)
		var ground:=ForceFirePoint.new()
		ground.position=initial.position+Vector2(60,0)
		initial._fire_shot(ground);Hero.tick(initial,2.9)
		check(Shield.amount(initial)==0,id+" force firing at ground resets shield delay")
		Hero.tick(initial,0.1)
		check(is_equal_approx(Shield.amount(initial),initial.max_hp*0.15),id+" recovery resumes after ground force fire stops")
		ground=null
		Shield.clear(initial);Hero.tick(initial,2.9)
		initial.special.iron_left=10
		initial.receive_hit(10,"bullet");initial.special.erase("iron_left")
		Hero.tick(initial,2.9)
		check(Shield.amount(initial)==0,id+" iron curtain deflected incoming hit still interrupts recovery")
		Hero.tick(initial,0.1)
		check(is_equal_approx(Shield.amount(initial),initial.max_hp*0.15),id+" recovery resumes after last deflected hit")
		Shield.clear(initial);Hero.tick(initial,2.5)
		var smoke_index:=UnitSkillLayout.find(initial,"ap_smoke")
		check(smoke_index>=0 and initial.use_ability(smoke_index),id+" smoke skill uses real ability entry")
		Hero.tick(initial,0.5)
		check(is_equal_approx(Shield.amount(initial),initial.max_hp*0.15),id+" stationary ability cast does not reset initial delay")
		Hero.tick(initial,0.5)
		initial.ability_at(smoke_index).cd_left=0
		initial.use_ability(smoke_index);Hero.tick(initial,0.5)
		check(is_equal_approx(Shield.amount(initial),initial.max_hp*0.2),id+" ability cast also preserves ongoing one second growth")
		initial.position+=Vector2(5,0);Hero.tick(initial,0.1)
		before=Shield.amount(initial);Hero.tick(initial,2.9)
		check(is_equal_approx(Shield.amount(initial),before),id+" displacement without velocity also interrupts residual recovery")
		Hero.tick(initial,0.1)
		check(is_equal_approx(Shield.amount(initial),before+initial.max_hp*0.15),id+" stopping displacement starts a new recovery cycle")
		initial.special[Shield.KEY].left=0.5
		Hero.tick(initial,0.5)
		check(Shield.amount(initial)==0 and not initial.special[Shield.KEY].growing,id+" natural expiry resets recovery cycle")
		Hero.tick(initial,2.9)
		check(Shield.amount(initial)==0,id+" expired shield waits full initial delay")
		Hero.tick(initial,0.1);Hero.tick(initial,1)
		check(is_equal_approx(Shield.amount(initial),initial.max_hp*0.2),id+" new cycle grows after natural expiry")
	check(Shield.Wave.front(0)==0 and Shield.Wave.front(0.3)>0 and Shield.Wave.front(Shield.Wave.LIFE)==1,"wave expands to the boundary without overshoot")
	var demo=preload("res://scripts/ui/hero_talent_demo.gd").new()
	add_child(demo)
	for id in Hero.IDS:
		demo.show_hero(id);demo.talent.select(0);demo._select_talent();demo.levels.select(0);demo.restart()
		check(not demo.caption.text.contains("护盾"),id+" command preview no longer describes shield")
		demo.talent.select(1);demo._select_talent();demo.levels.select(0);demo.restart()
		check(demo.caption.text.contains(Shield.DESCRIPTION),id+" survival zero preview describes shield")
		var target=hero(id,0,0,Vector2(700,700))
		var details:=preload("res://scripts/ui/battle_effect_details.gd").describe(target)
		check(details.contains("重装生存：\n"+Shield.DESCRIPTION),id+" battle details include survival rank zero")
	for id in Hero.IDS:
		var shown=hero(id,0,0,Vector2(600,600))
		var hud=screen.hud
		battle.select_unit(shown,false);battle._emit_selection()
		check(hud.sel_shield_label.visible and hud.sel_shield_label.text=="护盾 %s / %s" % [HpBar.shield_number(0),HpBar.shield_number(shown.max_hp*0.5)],id+" expanded HUD displays empty shield and real cap")
		Hero.tick(shown,3);hud._refresh_selection_live(false)
		var label_id:int=hud.sel_shield_label.get_instance_id()
		check(hud.sel_shield_label.text=="护盾 %s / %s" % [HpBar.shield_number(shown.max_hp*0.15),HpBar.shield_number(shown.max_hp*0.5)],id+" HUD follows actual shield gain")
		hud._toggle_unit_menu()
		check(hud._compact_vitals.is_ancestor_of(hud.sel_shield_label) and hud.sel_shield_label.visible,id+" collapse retains shield number alongside health and experience")
		for frame in 4:await get_tree().process_frame
		check(hud._compact_vitals.get_global_rect().encloses(hud.sel_shield_label.get_global_rect()),id+" collapsed shield text fits inside live compact container")
		Shield.absorb(shown,7.5);hud._refresh_selection_live(false)
		check(hud.sel_shield_label.get_instance_id()==label_id and hud.sel_shield_label.text.begins_with("护盾 "+HpBar.shield_number(Shield.amount(shown))+" /"),id+" collapsed shield updates damage without rebuilding controls")
		shown.special.hero_wreck={};hud._refresh_selection_live(false)
		check(not hud.sel_shield_label.visible,id+" wreck hides shield number")
		shown.special.erase("hero_wreck");hud._toggle_unit_menu()
		battle.select_unit(normal,false);battle._emit_selection()
		check(not hud.sel_shield_label.visible,id+" switching to ordinary tank removes shield row")
	var toggle := InputEventKey.new()
	toggle.keycode = KEY_SPACE
	toggle.shift_pressed = true
	toggle.pressed = true
	var was_paused: bool = battle.paused
	screen.hud._input(toggle)
	check(battle.show_all_health and battle.paused==was_paused,"Shift+Space reveals all visible HP without pausing")
	toggle.echo = true
	screen.hud._input(toggle)
	check(battle.show_all_health,"holding the shortcut does not repeatedly toggle")
	toggle.echo = false
	screen.hud._input(toggle)
	check(not battle.show_all_health and battle.paused==was_paused,"second press restores ordinary HP visibility")
	check(HpBar.readout("ally",99.5,120,0.2)=="100/120  盾 1","owned unit has integer HP and positive fractional shield")
	for other_side in ["enemy","ai2","neutral"]:
		check(HpBar.readout(other_side,99.5,120,27.8).is_empty() and HpBar.readout(other_side,120,120,0).is_empty(),"non-owned vitals show bars only, with or without shield: "+other_side)
	var inspected = battle.spawn_unit("HTNK","enemy",Vector2(830,640))
	if battle.fog!=null: battle.fog.reveal_contact("ally",inspected)
	battle._apply_selection(inspected.art_center(),false,Rect2())
	check(battle.health_inspection_target==inspected and battle.selected_units.is_empty(),"enemy click inspects health without taking control")
	battle.clear_selection()
	check(battle.health_inspection_target==null,"clearing selection clears health inspection")
	demo.queue_free()
	await finish()
	FileAccess.open(output_dir.path_join("result.json"),FileAccess.WRITE).store_string(JSON.stringify({"checks":checks,"failed":failed}))
	get_tree().quit(0 if failed==0 else 1)
