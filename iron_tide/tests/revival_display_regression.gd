extends "res://tests/tank_hero_regression.gd"
const Indicator=preload("res://scripts/ui/revival_indicator.gd")
const Demo=preload("res://scripts/ui/hero_talent_demo.gd")

func _ready() -> void:
	output_dir=OS.get_environment("IRON_TIDE_REPORT_DIR")
	if output_dir.is_empty() or not OS.get_user_data_dir().contains("CodexIronTideValidation"):
		get_tree().quit(2);return
	MetaProgress.reset_save();start(MatchRules.EXTENDED)
	for id in Hero.IDS:
		var unit=hero(id,1,0,Vector2(900,1200))
		check(Indicator.state(unit).is_empty(),id+" living hero has no countdown")
		unit.hp=0;unit._die()
		var start_state:=Indicator.state(unit)
		check(start_state.left==15 and start_state.progress==0 and start_state.text.contains("15.0"),id+" actual wreck starts with fifteen seconds")
		Hero.tick(unit,7.5)
		check(Indicator.state(unit).left==7.5 and Indicator.state(unit).progress==0.5,id+" countdown reads actual half timer")
		var unchanged=unit.special.hero_wreck.duplicate(true)
		for i in 5:Indicator.state(unit)
		check(unit.special.hero_wreck==unchanged,id+" repeated reads cannot advance combat")
		var codec=BattleSaves.Snapshot.new();var snapshot:=codec.capture(battle)
		codec.restore(battle,snapshot)
		unit=battle.units.filter(func(u):return u.special.get("academy_hero")==id)[0]
		check(Indicator.state(unit).left==7.5,id+" load resumes saved remaining time")
		Hero.tick(unit,7.49)
		check(Indicator.state(unit).text.contains("0.1"),id+" never shows zero before actual revival")
		Hero.tick(unit,0.02)
		check(Indicator.state(unit).is_empty(),id+" revival clears countdown")
		unit.hp=0;unit._die()
		check(Indicator.state(unit).is_empty(),id+" final death does not restart countdown")
	var demo:=Demo.new();add_child(demo);demo.show_hero("MTNK")
	demo.levels.select(1);demo.levels.item_selected.emit(1);demo.restart()
	check(demo.revival_status.visible and demo.revival_status.text.contains("15.0") and demo.duration()==17,"demo prominent label starts fifteen seconds with two-second completed hold")
	demo._process(1.0)
	check(demo.revival_status.text.contains("14.0"),"one-times demo uses real seconds")
	demo.playing=false;demo._process(3)
	check(demo.revival_status.text.contains("14.0"),"paused demo freezes countdown")
	demo.playback.seek(7.5)
	check(demo.revival_status.text.contains("7.5"),"scrubbing updates countdown immediately")
	demo.playback.seek(15)
	check(demo.revival_status.text.contains("已复活"),"demo completion label")
	demo.restart();demo.playback_speed=0.5;demo._process(2)
	check(demo.revival_status.text.contains("14.0"),"slow motion scales countdown with timeline")
	demo.levels.select(0);demo.levels.item_selected.emit(0)
	check(not demo.revival_status.visible and demo.duration()==6,"unrelated talent hides revival UI")
	demo.free();await finish()
	FileAccess.open(output_dir.path_join("result.json"),FileAccess.WRITE).store_string(JSON.stringify({"checks":checks,"failed":failed}))
	get_tree().quit(0 if failed==0 else 1)
