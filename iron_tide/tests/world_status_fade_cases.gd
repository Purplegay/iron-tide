extends RefCounted
const Status=preload("res://scripts/ui/unit_status.gd")

static func run(t) -> void:
	var unit=t.battle.spawn_unit("E1","ally",Vector2(1200,1200))
	unit.add_buff("attack",10,0.2,"fade probe")
	var canvas:CanvasItem=t.battle.hp_overlay
	if canvas.has_meta("world_status_fade"):canvas.remove_meta("world_status_fade")
	t.battle.clear_selection()
	var state:Dictionary=unit.special.duplicate(true)
	var buffs:Array=unit.buffs.duplicate(true)
	var health:float=unit.hp
	t.check(is_equal_approx(Status.world_opacity(unit,canvas,1000),1.0),"new unselected world status begins readable")
	t.check(is_equal_approx(Status.world_opacity(unit,canvas,1250),0.8),"unselected world status fades gradually after quarter second")
	t.check(is_equal_approx(Status.world_opacity(unit,canvas,1500),0.6),"unselected world status is sixty percent halfway through fade")
	t.check(is_equal_approx(Status.world_opacity(unit,canvas,2000),0.2) and is_equal_approx(Status.world_opacity(unit,canvas,9000),0.2),"unselected world status stops at twenty percent")
	t.battle.select_unit(unit,false)
	t.check(is_equal_approx(Status.world_opacity(unit,canvas,9001),1.0),"real unit selection immediately restores full opacity")
	t.check(is_equal_approx(Status.world_opacity(unit,canvas,20000),1.0),"selected unit never fades")
	t.battle.clear_selection()
	t.check(is_equal_approx(Status.world_opacity(unit,canvas,20001),1.0) and is_equal_approx(Status.world_opacity(unit,canvas,20501),0.6),"deselecting starts a fresh gradual fade")
	t.battle.select_unit(unit,false)
	t.check(is_equal_approx(Status.world_opacity(unit,canvas,20502),1.0),"reselecting during fade immediately restores opacity")
	var other=t.battle.spawn_unit("MTNK","ally",Vector2(1300,1200))
	Status.world_opacity(other,canvas,20502)
	t.battle.select_unit(other,true)
	t.check(is_equal_approx(Status.world_opacity(unit,canvas,21502),1.0) and is_equal_approx(Status.world_opacity(other,canvas,21502),1.0),"all members of multiselection remain clear")
	t.battle.clear_selection()
	Status.world_opacity(unit,canvas,22000);Status.world_opacity(other,canvas,22000)
	t.battle.select_unit(other,false)
	t.check(is_equal_approx(Status.world_opacity(unit,canvas,23000),0.2) and is_equal_approx(Status.world_opacity(other,canvas,23000),1.0),"opacity is independent for each unit")
	t.check(unit.special==state and unit.buffs==buffs and unit.hp==health,"fade never changes buffs timers health or saved gameplay state")
	for color in [Color("#101b26"),Color.WHITE,Color.TOMATO,Color.BLACK,Color(0.2,0.4,0.6,0.5)]:
		var tint:=Status.faded(color,0.2)
		t.check(is_equal_approx(tint.a,color.a*0.2) and tint.r==color.r and tint.g==color.g and tint.b==color.b,"background icon debuff outline and stack text share alpha without changing RGB "+str(color))
	t.battle.select_unit(unit,false);t.battle._emit_selection();t.screen.hud._rebuild_buff_bar()
	t.check(t.screen.hud.buff_panel.modulate.a==1.0 and unit.modulate.a==1.0 and canvas.modulate.a==1.0,"HUD status panel actor and health overlay opacity stay untouched")
	# The deployed gun uses building selection propagated by the real Building API.
	var tower=t.battle._place_building("R3REAPERTURRET","ally",Vector2(2100,1800),true)
	var mount=preload("res://scripts/buildings/ra3_reaper_emplacement.gd").mount(tower)
	t.battle.select_building(tower)
	t.check(mount.selected and is_equal_approx(Status.world_opacity(mount,canvas,24000),1.0),"selecting deployed reaper keeps mounted status clear")
	t.battle.clear_selection();Status.world_opacity(mount,canvas,24001)
	t.check(not mount.selected and is_equal_approx(Status.world_opacity(mount,canvas,25001),0.2),"deselected deployed reaper fades like a unit")
	var cache=canvas.get_meta("world_status_fade")
	var old_id:int=other.get_instance_id()
	t.battle.units.erase(other);other.free()
	Status.world_opacity(unit,canvas,28000)
	t.check(not cache.rows.has(old_id),"fade cache releases freed units through weak references")
	canvas.remove_meta("world_status_fade")
	t.check(is_equal_approx(Status.world_opacity(unit,canvas,30000),1.0),"new overlay lifecycle does not inherit previous opacity")
	canvas.remove_meta("world_status_fade")
	t.battle.clear_selection()
