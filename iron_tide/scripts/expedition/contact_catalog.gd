const PORTRAITS=preload("res://assets/ui/expedition_commanders.webp")
static var portraits:Dictionary={}

static func portrait(id:String) -> Texture2D:
	if not PEOPLE.has(id):return null
	if PEOPLE[id].has("portrait"):return PEOPLE[id].portrait
	if not portraits.has(id):
		var tile:int=PEOPLE[id].portrait_tile
		var texture:=AtlasTexture.new()
		var edge:=PORTRAITS.get_width()/4
		texture.atlas=PORTRAITS
		texture.region=Rect2((tile%4)*edge,(tile/4)*edge,edge,edge)
		texture.filter_clip=true
		portraits[id]=texture
	return portraits[id]
