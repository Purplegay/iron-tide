static func text(data: Dictionary) -> String:
	var id := str(data.get("id", ""))
	if DETAILS.has(id): return str(DETAILS[id])
	var description := str(data.get("desc", ""))
	var role := str(data.get("role_name", data.get("role", "单位")))
	var weapon: Dictionary = data.get("weapon", {})
	var fallback := "%s。%s" % [role, "没有常规武器。" if weapon.is_empty() else CombatMath.describe_weapon(weapon)]
	var result := description + "\n" + fallback if not description.is_empty() else fallback
	if id == "R3REAPER": result += "\n" + REAPER_CD_GUIDE
	return result
