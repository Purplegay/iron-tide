const GM_FIELDS := ["enabled", "god_mode", "one_shot_kill", "infinite_funds", "infinite_power", "no_build_time", "unlock_production_tech", "auto_win"]

static func fields(kind: String) -> Array:
	return FIELDS.get(kind, [])

static func kind_for(path: String) -> String:
	for kind in PATHS:
		if PATHS[kind] == path: return kind
	return ""
