+func _hold_vacated_scouts(scouts: Dictionary, remaining: float) -> void:
+	# Small encounters do not amortize creating alliance masks.
+	if _scouts.size() < 64:
+		for id in _scouts:
+			var old: Dictionary = _scouts[id]
