+		if current.get("side") != old.side: current = {}
+		var team = BattleRequest.house_teams.get(old.side, old.side)
+		if not masks.has(team):
+			var mask := Image.create(width, width, false, Image.FORMAT_L8)
+			mask.fill(Color.BLACK)
